<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Top Navigation Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="90dp"
                android:background="@drawable/btn_chip"
                android:text="← Назад"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="16dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Умный Always On Display"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <!-- Main Card: Умное затухание AOD (Always On Display) -->
        <LinearLayout
            android:id="@+id/card_aod_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_cat_aod"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Умное затухание AOD"
                    android:textColor="@color/accent_purple"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_chip"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="OLED Защита"
                    android:textColor="@color/accent_purple"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Показывает часы и уведомления при блокировке, а через выбранное время плавно гасит Always On Display (doze_always_on 0)\n• Предотвращает выгорание OLED-матрицы в зоне статических часов\n• Экономит до 15–20% заряда аккумулятора за день\n• При пробуждении или касании AOD моментально восстанавливается"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btn_toggle_aod_timeout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_primary"
                android:text="🌙 Включить умное затухание AOD"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_aod_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_aod_timeout_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Время до затухания: 15 сек (Рекомендуемое)"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btn_aod_5s"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="5 сек"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/btn_aod_10s"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="10 сек"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/btn_aod_15s"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_primary"
                        android:text="15 сек"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/btn_aod_30s"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="30 сек"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/btn_aod_60s"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="60 сек"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:layout_marginStart="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_aod_keep_charging"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_chip"
                    android:text="⚡ Не гасить AOD при подключённой зарядке: ВКЛ ✓"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
