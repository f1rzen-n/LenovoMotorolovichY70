<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Top Navigation Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="90dp"
                android:background="@drawable/btn_chip"
                android:text="← Назад"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="16dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Отклик сенсора"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <!-- Main Card: Управление откликом сенсора и тача -->
        <LinearLayout
            android:id="@+id/card_touch_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_cat_touch"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Отклик сенсора и Турбо-режим"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_chip"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="Goodix Touch"
                    android:textColor="@color/accent_purple"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Аппаратный опрос сенсора Goodix: высокая точность при ведении пальца и мгновенный отклик при касаниях и свайпах\n• Что меняет ползунок: системный фильтр сглаживания и скорость считывания касаний Android\n• Кнопка «Турбо-режим» в 1 клик включает 144 Гц экрана, переводит сенсор в игровой режим и ставит максимум чувствительности 100%"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <!-- Slider Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:background="#151921"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Чувствительность отклика:"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_menu_touch_speed_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50% — Сток (Сглаживание дрожания ⚖️)"
                        android:textColor="@color/accent_purple"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_menu_touch_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="14"
                    android:progress="7" />

                <!-- Preset Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btn_menu_touch_stock"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="30dp"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="⚖️ Сток (50%)"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_menu_touch_game"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="30dp"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="🎮 Игра (85%)"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_menu_touch_turbo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="30dp"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="⚡ Турбо (100%)"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_purple"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Detailed Explanation of Levels -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#0D1117"
                    android:padding="8dp"
                    android:text="• 50% (Сток): система сглаживает естественное микро-дрожание рук для плавности в интерфейсе\n• 85% (Игра): сниженная задержка ввода, быстрый разворот прицела\n• 100% (Турбо): фильтр задержки отключен (0 мс), прямое считывание для мгновенной стрельбы"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Master Action Buttons -->
            <Button
                android:id="@+id/btn_menu_apply_turbo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_purple"
                android:text="⚡ Включить Турбо-режим (144 Гц + Макс. отклик)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_menu_reset_stock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_chip"
                android:text="🔄 Сбросить к стоку (Авто Гц + Сток 50% + UI 1.0x)"
                android:textAllCaps="false"
                android:textColor="@color/accent_yellow"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- UI Animation Latency Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:background="#151921"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Скорость анимаций UI:"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_menu_anim_speed_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0x (Сток ⚖️)"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ускорение анимаций в 2 раза (0.5x) убирает визуальные задержки системы."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_menu_anim_boost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_primary"
                        android:text="🚀 Ускорить UI (0.5x)"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_menu_anim_stock"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="🔄 Сток (1.0x)"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
