<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Top Navigation Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="90dp"
                android:background="@drawable/btn_chip"
                android:text="← Назад"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="16dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Защита зрения"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <!-- Main Card: Защита глаз и экранные твики (DC Dimming / Анти-ШИМ) -->
        <LinearLayout
            android:id="@+id/card_eye_care"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_cat_eyecare"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Защита глаз и экран (OLED)"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_chip"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="DC Dimming • ШИМ"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Аппаратный DC Dimming (Анти-ШИМ): устраняет мерцание OLED-матрицы на низкой яркости, снижает нагрузку на зрение\n• Ночной режим: фильтрация синего спектра для комфорта в темноте\n• Экстра-затемнение: снижение яркости ниже системного порога"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btn_toggle_dc_dimming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_primary"
                android:text="👁️ DC Dimming (Анти-ШИМ): Включить"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_toggle_night_light"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_chip"
                    android:text="🌙 Ночной режим: Выкл"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_toggle_extra_dim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_chip"
                    android:text="🌑 Экстра-затемнение: Выкл"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Anti-Black Smearing Submenu Toggle Button -->
            <Button
                android:id="@+id/btn_toggle_smearing_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_chip"
                android:text="🌑 Анти-шлейф чёрного (Anti-Black Smearing)  ▼"
                android:textAllCaps="false"
                android:textColor="@color/accent_purple"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Collapsible Anti-Black Smearing Submenu -->
            <LinearLayout
                android:id="@+id/layout_smearing_submenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#151921"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <!-- Method 1: OLED Black Floor Lift -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1. Подъём уровня чёрного (Black Floor)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_black_floor_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Выкл (#000000)"
                        android:textColor="@color/accent_purple"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Смещение чёрного #000000 → #030303–#060606 через SurfaceFlinger (ColorMatrix с Root или HWC-слой без Root). Пиксели OLED остаются предзаряженными — шлейф текста исчезает."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

                <SeekBar
                    android:id="@+id/sb_black_floor_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="8"
                    android:progress="4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <Button
                        android:id="@+id/btn_bf_low"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="30dp"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="#030303 (+1.2%)"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_bf_med"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="30dp"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="#040404 (+1.6%)"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_purple"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_bf_high"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="30dp"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="#060606 (+2.4%)"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_black_floor_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_purple"
                    android:text="✨ Включить подъём чёрного (#040404)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/card_stroke" />

                <!-- Method 2: High Matrix Brightness + Extra Dim Combo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Связка «Яркость матрицы 25–35% + Extra Dim»"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Держит аппаратное напряжение OLED выше (без смазывания), а итоговую яркость мягко гасит вниз через Extra Dim."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

                <Button
                    android:id="@+id/btn_smearing_combo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_primary"
                    android:text="💡 Включить связку (Яркость 30% + Extra Dim)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Интенсивность Extra Dim:"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_extra_dim_level_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50%"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_extra_dim_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="50" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <Button
                        android:id="@+id/btn_bright_25"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="30dp"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="☀️ Яркость 25%"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_bright_30"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="30dp"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="☀️ Яркость 30%"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_blue"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_bright_35"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="30dp"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="☀️ Яркость 35%"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/card_stroke" />

                <!-- Method 3: 120 / 144 Hz + DC Dimming Gamma Tables -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Фиксация 120 / 144 Гц + DC Dimming"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="На 120/144 Гц и при переключении DC Dimming драйвер панели меняет гамма-таблицы — подберите режим с минимальным шлейфом."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_smearing_120hz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="120 Гц"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_smearing_144hz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_chip"
                        android:text="144 Гц"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_smearing_dc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_weight="1.3"
                        android:background="@drawable/btn_chip"
                        android:text="DC Dim: Выкл"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
